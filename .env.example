# Apps Script endpoint (base /exec URL). The app adds ?email=<student>&sheets=<competency sheets> per request.
SHEETS_API_URL="https://script.google.com/macros/s/<deployment-id>/exec"
SESSION_SECRET="replace-with-a-long-random-string"
REPORT_REQUIRE_SHARED="true"
# Full admin: student reports + user analytics
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="choose-a-strong-admin-password"
# View-only admin: student reports only
ADMIN_VIEWER_USERNAME="viewer"
ADMIN_VIEWER_PASSWORD="choose-another-strong-password"
# Analytics database (Postgres, e.g. Neon). Without it, local dev uses an embedded database in .data/
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
